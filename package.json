{
  "name": "pop",
  "private": true,
  "description": "PoP: Proof of Purchase. Protected checkout on Whitechain, reviews on Arkiv, World ID-gated.",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:web": "npm run build -w @pop/web",
    "build:store": "npm run build -w @pop/demo-store",
    "build": "npm run build:web && npm run build:store",
    "smoke:whitechain": "tsx scripts/smoke-whitechain.ts",
    "smoke:arkiv": "tsx scripts/smoke-arkiv.ts",
    "smoke:db": "tsx scripts/smoke-db.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:reset-fork": "tsx scripts/db-reset-fork.ts",
    "seed:merchant": "tsx scripts/seed-merchant.ts",
    "webhooks": "tsx scripts/webhooks-loop.ts",
    "e2e:merchant": "tsx scripts/e2e-merchant.ts",
    "wallets": "tsx scripts/gen-wallets.ts",
    "typecheck:shared": "tsc -p packages/shared --noEmit",
    "fork": "tsx scripts/fork.ts",
    "fork:fund": "tsx scripts/fork-fund.ts",
    "deploy": "tsx scripts/deploy.ts",
    "seed": "tsx scripts/seed-seller.ts",
    "fork:up": "tsx scripts/fork-fund.ts && tsx scripts/deploy.ts && tsx scripts/db-migrate.ts && tsx scripts/seed-seller.ts",
    "abi": "tsx scripts/export-abi.ts",
    "dev:web": "npm run dev -w @pop/web"
  },
  "devDependencies": {
    "@scure/bip39": "^2.4.0",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "dotenv": "18.0.9",
    "tsx": "4.23.15",
    "typescript": "^5"
  },
  "dependencies": {
    "@arkiv-network/sdk": "1.0.1",
    "pg": "8.23.1",
    "viem": "2.57.16"
  }
}
