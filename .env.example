# PoP: Proof of Purchase. Copy to .env and fill in. NEVER commit .env.
# Source: specs/PoP_Technical_Architecture.md §12, plus additions marked (added).

# ---------- Whitechain (Sepolia testnet, chain 1874) ----------
# Public RPC (docs.whitechain.io/learn/network/reference): https://rpc.testnet.whitechain.io
# WebSocket: wss://rpc.testnet.whitechain.io/ws
# Explorer (Blockscout): https://explorer.testnet.whitechain.io  verifier: --verifier blockscout --verifier-url https://explorer.testnet.whitechain.io/api/
WHITECHAIN_RPC_URL=
WHITECHAIN_CHAIN_ID=1874
USDT_ADDRESS=0xcedfB56113143d55b2358b8CFbB0dEB5Ad2f55a7
CHECKOUT_ADDRESS=
REGISTRY_ADDRESS=
ATTESTOR_PK=
COURIER_PK=
FAUCET_PK=
ARBITER_PK=                    # (added) team arbiter wallet for scripts; the /arbiter page uses a browser wallet
DEPLOYER_PK=                   # local only, never in Vercel
TEST_BUYER_PK=                 # (added) throwaway buyer for smoke tests

# ---------- Arkiv (Rabdi testnet, chain 7794095) ----------
ARKIV_ACCESS_KEY=              # hub.arkiv.network/access-keys (server only, never NEXT_PUBLIC_)
ARKIV_CHAIN_ID=7794095

# ---------- World (IDKit 4.x / World ID 4.0) ----------
WORLD_APP_ID=
NEXT_PUBLIC_WORLD_APP_ID=
WORLD_RP_ID=                   # (added) World ID 4.0 relying-party id from the Developer Portal
WORLD_RP_SIGNING_KEY=          # (added) secret, server only; shown once in the portal
WORLD_ACTION=review
WORLD_ENVIRONMENT=staging      # (added) staging = simulator.worldcoin.org

# ---------- Reclaim (later; tier-1 bio code first) ----------
RECLAIM_APP_ID=
RECLAIM_APP_SECRET=
RECLAIM_INSTAGRAM_PROVIDER_ID=

# ---------- App ----------
DATABASE_URL=
ADDRESS_ENC_KEY=               # 32 bytes base64
SESSION_SECRET=
NEXT_PUBLIC_BASE_URL=

# ---------- Demo store (separate Vercel project, its own env) ----------
MERCHANT_PK=
POP_API_KEY=
POP_WEBHOOK_SECRET=
# ARKIV_ACCESS_KEY=            # the demo store uses its OWN key (set in its own env)
POP_ATTESTOR_ADDRESS=
