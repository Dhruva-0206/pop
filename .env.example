# PoP: Proof of Purchase. Copy to .env and fill in. NEVER commit .env.
# Source: specs/PoP_Technical_Architecture.md §12, plus additions marked (added).

# ---------- Network mode (one switch) ----------
# fork    = LOCAL anvil fork of Whitechain Sepolia 1874 (real USDT bytecode; balances written by scripts; NOT real payments)
# testnet = real Whitechain Sepolia 1874
NETWORK_MODE=fork
FORK_RPC_URL=http://127.0.0.1:8545

# ---------- Whitechain (Sepolia testnet, chain 1874) ----------
# Public RPC (docs.whitechain.io/learn/network/reference): https://rpc.testnet.whitechain.io
# WebSocket: wss://rpc.testnet.whitechain.io/ws
# Explorer (Blockscout): https://explorer.testnet.whitechain.io  verifier: --verifier blockscout --verifier-url https://explorer.testnet.whitechain.io/api/
WHITECHAIN_RPC_URL=
WHITECHAIN_CHAIN_ID=1874
USDT_ADDRESS=0xcedfB56113143d55b2358b8CFbB0dEB5Ad2f55a7
CHECKOUT_ADDRESS=
REGISTRY_ADDRESS=
ATTESTOR_PK=
COURIER_PK=
FAUCET_PK=
ARBITER_PK=                    # (added) team arbiter wallet for scripts; there is no /arbiter page yet
DEPLOYER_PK=                   # local only, never in Vercel
TEST_BUYER_PK=                 # (added) throwaway buyer for smoke tests
SELLER_PK=                     # (added) demo seller @meera.jewels (seeded by scripts)

# ---------- Arkiv (Rabdi testnet, chain 7794095) ----------
ARKIV_ACCESS_KEY=              # hub.arkiv.network/access-keys (server only, never NEXT_PUBLIC_)
ARKIV_CHAIN_ID=7794095

# ---------- World (IDKit 4.x / World ID 4.0) ----------
WORLD_APP_ID=
NEXT_PUBLIC_WORLD_APP_ID=
WORLD_RP_ID=                   # (added) World ID 4.0 relying-party id from the Developer Portal
WORLD_RP_SIGNING_KEY=          # (added) secret, server only; shown once in the portal
WORLD_REVIEW_ACTIONS=          # (changed) optional JSON override {"handle":"action"}; defaults in packages/shared WORLD_REVIEW_ACTIONS
WORLD_ENVIRONMENT=staging      # (added) staging = simulator.worldcoin.org

# ---------- Reclaim (later; tier-1 bio code first) ----------
RECLAIM_APP_ID=
RECLAIM_APP_SECRET=
RECLAIM_INSTAGRAM_PROVIDER_ID=

# ---------- App ----------
DATABASE_URL=              # Supabase Postgres (pooler URL). REQUIRED, no file fallback. Then run: npm run db:migrate
ADDRESS_ENC_KEY=               # 32 bytes base64
SESSION_SECRET=
COURIER_PASSCODE=              # (added) team passcode for the SIMULATED COURIER page
NEXT_PUBLIC_BASE_URL=

# ---------- Demo store (separate Vercel project, its own env) ----------
MERCHANT_PK=
POP_API_KEY=
POP_WEBHOOK_SECRET=
# ARKIV_ACCESS_KEY=            # the demo store uses its OWN key (set in its own env)
POP_ATTESTOR_ADDRESS=
# Demo store only (apps/demo-store/.env.local is written by scripts/seed-merchant.ts; add the next line by hand):
# KURTA_ARKIV_ACCESS_KEY=      # the store's OWN Arkiv key
# Optional pin so the store does not rely on PoP for the contract address:
# CHAIN_ID=1874  RPC_URL=https://rpc.testnet.whitechain.io  CHECKOUT_ADDRESS=  REGISTRY_ADDRESS=  DEPLOY_BLOCK=12330545

# ---------- DEV ONLY (never put this in .env or in Vercel) ----------
# POP_DEV_SKIP_WORLD=1   set in the SHELL of a local `next dev` only, to skip ONLY the World proof when testing the Arkiv review path.
#                        Ignored-and-refused on any production/deployed build (the review route returns 500 if it is set there).
#                        Reviews written this way carry a dev- reviewer key, expire after 24 h and are not counted as verified humans.
